# 로컬 개발용(단독 저장)
# 이 모드에서는 data/shared-kv-store.json 파일에 저장됩니다.

SHARED_DB_PATH=./data
CENTRAL_DB_SOURCE=local-dev
SHARED_DB_REQUIRE_CENTRAL=0
SHARED_DB_ALLOW_SEED=1
CENTRAL_DB_TIMEOUT_MS=1500

# 로그인/세션
INFOBIZ_COMMON_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
INFOBIZ_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_SESSION_SECRET=local-dev-session-secret
AUTH_COOKIE_SECURE=0

# 로컬 저장소 비대화 방지
SHARED_KV_AUDIT_RETAIN_LIMIT=200
SHARED_KV_AUDIT_SNAPSHOT_LIMIT=20000
SHARED_KV_MEMORY_LIMIT_BYTES=30000000
SHARED_DB_ALLOW_REMOTE_WRITE_FROM_LOCAL=0

# 중앙 API를 쓰지 않을 때는 비워둡니다.
CENTRAL_DB_API_URL=
CENTRAL_DB_API_TOKEN=
SHARED_KV_API_KEY=

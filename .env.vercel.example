# Production persistent state storage
#
# Add Vercel KV or an Upstash Redis database to the Vercel project, then set:
KV_REST_API_URL=https://YOUR_KV_REST_API_URL
KV_REST_API_TOKEN=YOUR_KV_REST_API_TOKEN

# Production should write to KV, not to local files.
CENTRAL_DB_SOURCE=vercel-production
SHARED_DB_REQUIRE_CENTRAL=1
SHARED_DB_ALLOW_SEED=0
CENTRAL_DB_TIMEOUT_MS=3000

# Leave these empty in production unless you intentionally proxy through
# another central API server. Do not point this to the same Vercel domain
# unless that route is backed by Redis/KV.
CENTRAL_DB_API_URL=
CENTRAL_DB_API_TOKEN=
SHARED_KV_API_KEY=

# Optional local file fallback. Do not use this for Vercel production.
SHARED_DB_PATH=

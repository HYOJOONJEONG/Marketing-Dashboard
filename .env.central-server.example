# 중앙 DB 서버용(Contabo 등)
# 이 서버가 실제 shared-kv-store.json 또는 Redis/KV 저장소를 소유합니다.

SHARED_DB_PATH=./data

# 중앙 API에서 인증할 토큰(클라이언트와 동일해야 함)
CENTRAL_DB_API_TOKEN=CHANGE_ME_STRONG_TOKEN
SHARED_KV_API_KEY=CHANGE_ME_STRONG_TOKEN

# 로그인/세션
INFOBIZ_COMMON_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
INFOBIZ_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AUTH_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET

# http://서버IP:3000 으로 직접 테스트할 때는 0, HTTPS/리버스프록시 뒤에서는 1
AUTH_COOKIE_SECURE=0

# 중앙 서버 본인은 자기 API를 다시 호출할 필요가 없으므로 비워둡니다.
CENTRAL_DB_API_URL=
CENTRAL_DB_SOURCE=central-server
SHARED_DB_REQUIRE_CENTRAL=0
SHARED_DB_ALLOW_SEED=0
CENTRAL_DB_TIMEOUT_MS=1500

# 저장공간/수정로그 보호
SHARED_KV_AUDIT_RETAIN_LIMIT=200
SHARED_KV_AUDIT_SNAPSHOT_LIMIT=20000
SHARED_KV_MEMORY_LIMIT_BYTES=30000000

# 중앙 DB 서버용(Contabo 등)
# 이 서버가 실제 shared-kv-store.json 또는 Redis/KV 저장소를 소유합니다.

SHARED_DB_PATH=./data

# 중앙 API에서 인증할 토큰(클라이언트와 동일해야 함)
CENTRAL_DB_API_TOKEN=CHANGE_ME_STRONG_TOKEN
SHARED_KV_API_KEY=CHANGE_ME_STRONG_TOKEN

# 중앙 서버 본인은 자기 API를 다시 호출할 필요가 없으므로 비워둡니다.
CENTRAL_DB_API_URL=
CENTRAL_DB_SOURCE=central-server
SHARED_DB_REQUIRE_CENTRAL=0
SHARED_DB_ALLOW_SEED=0
CENTRAL_DB_TIMEOUT_MS=1500
